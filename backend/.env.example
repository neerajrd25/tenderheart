NODE_ENV=development
PORT= 
DB_URL=
DB_NAME=daycare_app 
GOOGLE_CLIENT_ID=
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM=info@nexuschainconsulting.com
FRONTEND_URL=http://localhost:3000
DEV_BYPASS_AUTH=false
# Daycare timezone: used for the auto-send schedule and times shown in parent emails
APP_TIMEZONE=Asia/Kolkata
# When complete, unsent reports are emailed automatically (EventBridge Scheduler cron, in APP_TIMEZONE)
AUTO_SEND_SCHEDULE="cron(0 19 * * ? *)"
